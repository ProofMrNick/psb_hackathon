# Адрес API модели (локально Ollama)
LLM_BASE_URL=http://localhost:11434/v1

# API ключ 
LLM_API_KEY=ollama

# Название модели
LLM_MODEL=qwen2.5:7b

# Модель для эмбеддингов (на платформе BAAI/bge-m3, локально пусто)
EMB_MODEL=

# Путь к папке с данными
DATA_DIR=data

# Количество параллельных запросов
MAX_WORKERS=4

# Максимальное количество токенов в ответе
MAX_TOKENS=400

# Температура генерации
TEMPERATURE=0.1

# Количество найденных фрагментов для контекста
TOP_K=6

# Лимит времени выполнения (секунды)
TIME_BUDGET_SEC=1020