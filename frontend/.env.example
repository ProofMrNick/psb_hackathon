
# ПРИМЕР .env файла для Frotnend. Скопируйте этот файл в .env и настройте под себяю

# ----- Порты -----
# Порт, на котором запускается Vite dev-сервер
APP_PORT=5173

# ----- Бэкенд -----
# Включить on-demand fetch для некоторых операций (experimental)
ALLOW_ON_DEMAND_FETCH=false

# Базовый URL бэкенд-сервиса (Express API)
VITE_API_BASE_URL=http://localhost:8000

# ----- GitHub (для виджетов / ссылок на код в UI) -----
VITE_GITHUB_USER=ProofMrNick
VITE_GITHUB_REPO=psb_hackathon
VITE_GITHUB_BRANCH=main

# ----- Режим работы API -----
# true  = использовать mockFetch (заглушка, бэкенд не нужен)
# false = использовать настоящий бэкенд по VITE_API_BASE_URL
# ВАЖНО: после изменения значения обязательно перезапустите dev-сервер!
VITE_TEST_API=true