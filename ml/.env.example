# Copy to ml/.env. Do not commit real keys.
# Point both services to an OpenAI-compatible API endpoint.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b

# Hybrid search needs BGE-M3 embeddings via proxy OR local model.
# When using a proxy (e.g. the platform's), set EMB_MODEL to its BGE-M3 id:
EMB_MODEL=
# An empty EMB_MODEL loads BAAI/bge-m3 locally via sentence-transformers.
DATA_DIR=data
TOP_K=6
CANDIDATE_K=30
CONTEXT_CHARS=2000
MAX_TOKENS=400
TEMPERATURE=0.1
ML_HOST=127.0.0.1
ML_PORT=8001
